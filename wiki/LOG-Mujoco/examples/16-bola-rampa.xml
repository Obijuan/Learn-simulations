<!-- Incluir esquema para validar ficheros xml -->
<mujoco model="Ejemplo 16"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/google-deepmind/mujoco/3.13.0/src/xml/generated/mjcf.xsd"
        >

  <!-- Recursos -->
  <asset>

    <!-- Establecer textura de "ajedrez",
         con dos colores: "azul apagado" y "gris" -->
    <texture name="grid" type="2d"
      builtin="checker" width="512" height="512"
      rgb1="0 0 .1" rgb2=".3 .3 .3" />

    <!-- Establecer el color del cielo -->
    <texture type="skybox" builtin="gradient" 
      rgb1="0 0 1" rgb2="0 0 1" 
      width="32" height="512"/>

    <!-- Definir un material etiquetado como "satinado" -->
    <!-- que incluye un "grid" -->
    <material name="azulejos" reflectance=".2" texture="grid"/>
  </asset>

  <worldbody>

    <!-- Suelo del mundo -->
    <!-- Suelo a cuadrados con reflejos -->
    <geom type="plane" size="0 0 1" material="azulejos"/> 

    <geom type="box" size="1.5 .5 .01"
          euler="0 30 0"
          pos="1 0 0.75"
          rgba="0 0.6 0 1"/>

    <!-- Colocar una luz encima de la bola, a una distancia 
         fija de su centro de masas. Es decir, que 
         "sigue" a la bola: ES UN FOCO! -->
    <light pos="0 0 2.6" mode="trackcom"/>

    <!-- Bola libre: De color rojo  -->
    <body pos="0 0 2">
      <geom type="sphere" size="0.2"
            rgba="1 0 0 1" />
      <joint type="free"/>
    </body>
    
  </worldbody>
</mujoco>
