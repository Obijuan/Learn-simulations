<mujoco model="Ejemplo 9">
  
  <!-- Recursos -->
  <asset>
    <!-- Definir un material etiquetado como "satinado" -->
    <!-- Activar el reflejo -->
    <material name="satinado" reflectance=".2"/>
  </asset>


  <worldbody>

    <!-- Suelo del mundo -->
    <!-- Se le da un aspecto "brillante", como si fuese -->
    <!-- un azulejo limpio -->
    <geom type="plane" size="0 0 1" material="satinado"/> 

    <!-- Bola libre  -->
    <body pos="0 0 2">
      <geom type="sphere" size="0.2"/>
      <joint type="free"/>
    </body>
    
  </worldbody>
</mujoco>
